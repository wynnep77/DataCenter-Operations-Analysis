# Callan Operational Dashboard v2 - Environment Configuration
# Copy this file to .env and set ADMIN_TOKEN before running docker compose up

# REQUIRED: Administrator token for the Administrator tab (X-Admin-Token header)
# Generate a secure random token: openssl rand -hex 24
ADMIN_TOKEN=CHANGE_THIS_TO_SECURE_RANDOM_TOKEN

# Ollama Configuration
OLLAMA_MODEL=qwen3:8b
OLLAMA_EXTRA_MODELS=
ALLOWED_MODELS=qwen3:8b,qwen3:14b,qwen3:4b
OLLAMA_NUM_CTX=12288
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1

# Optional: Pin Ollama image version for production stability
# Uncomment and set to a specific tag (e.g., "0.5.7") instead of latest
# OLLAMA_IMAGE_TAG=latest

# LLM Configuration
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=600

# API Limits
MAX_CONCURRENT_CHATS=2
MAX_HISTORY_MESSAGES=12
MAX_CONTEXT_CHARS=30000

# Web Server Configuration
WEB_BIND=0.0.0.0
WEB_PORT=8081

# Optional: CORS origins (comma-separated, only needed if not behind bundled nginx)
# CORS_ORIGINS=http://localhost:8081,https://yourdomain.com

# Docker Build Configuration (optional)
# REGISTRY=your-registry
# TAG=2.0.0-dev

# GPU Configuration
# Number of GPUs to allocate to Ollama (default: 1)
GPU_COUNT=1
